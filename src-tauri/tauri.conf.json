{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Nothing",
  "version": "0.1.0",
  "identifier": "com.nothing.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nothing",
        "width": 720,
        "height": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self';"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "An application that intentionally does almost nothing.",
    "longDescription": "An application that intentionally does almost nothing."
  }
}
